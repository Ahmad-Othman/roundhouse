# Typing for runtime/spinel/signed_cookies.rb.
module ActionDispatch
  module SignedCookie
    def self.sign: (String value, String name) -> String
    def self.verified: (String raw, String name) -> String
  end

  class Session
    def self.from_signed_cookie: (String raw, String name) -> Session
    def self.signed_cookie: (String plain, String name) -> String
  end
end
